--- !u!114 &1475724517
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1475724516}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5e0d1a44aafc655488961a22efaf6ca9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HeadBarks
  bubble: {fileID: 1698221123}
  label: {fileID: 1081717398}
  labelHeight: 0.75
  labelFollowSmoothing: 12
  autoWireEvents: 1
  displayTime: 2.6
  fadeTime: 0.4
  idleChatterDelay: 18
  idleChatterInterval: 22
  onPickedUp:
    label: Picked up
    lines:
    - Hello My Sweet!
    - Careful, that's my good side.
    - I am so glad to see you!
    - You're so cute!
  onThrown:
    label: Thrown
    lines:
    - WHEEEE
    - This is fine!
    - I regret everything!
    - Tell my body I love it!
  onLanded:
    label: Landed
    lines:
    - Ow.
    - Ten out of ten. Do it again.
    - I saw the whole sky.
    - That one's going to bruise.
  onDropped:
    label: Dropped
    lines:
    - Rude.
    - Just gonna leave me here?
    - You're lucky that you're cute.
  onMemoryFound:
    label: Memory found
    lines:
    - Oh, I remember that one.
    - That's a good one.
    - I was so nervous that day.
    - One step closer to having a neck.
  onIdle:
    label: Idle / ignored
    lines:
    - Still here.
    - Just a head. In some grass. Living the dream.
    - No rush.
    - Do you think my body misses me?
  onNearBody:
    label: Near the body
    lines:
    - Hey. That's mine.
    - So close.
    - Line me up, you've got this.
